# Bu dosyayı server/.env olarak kopyala ve değerleri doldur.
# Her değerin nereden alınacağı: docs/SETUP.md

# --- Sunucu ---
NODE_ENV=development
PORT=5000

# --- Veritabanı (Neon) — docs/SETUP.md#4-neon-postgresql ---
# Neon'un verdiği adreslerde "sslmode=require" yerine "sslmode=verify-full" yaz
# (pg sürücüsü zaten böyle davranıyor; açıkça yazınca uyarı vermiyor).
# Pooled bağlantı (adreste "-pooler" geçer). Uygulama bunu kullanır.
DATABASE_URL=
# Direct bağlantı. Şema güncellemeleri (migration) bunu kullanır.
DIRECT_URL=

# --- Kimlik doğrulama ---
# Rastgele uzun bir değer: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Dış API'ler ---
# TMDB "API Read Access Token" (eyJ ile başlar) — docs/SETUP.md#1-tmdb
TMDB_API_TOKEN=
# docs/SETUP.md#2-omdb
OMDB_API_KEY=
# docs/SETUP.md#3-google-books
GOOGLE_BOOKS_API_KEY=
# Anahtar değil, kimlik: Open Library ve Vikipedi kim olduğumuzu bilmek ister (uygulama adı + iletişim e-postası)
APP_USER_AGENT="FilmDiziKitap/0.1 (email@ornek.com)"

# --- E-posta doğrulama (Brevo, ücretsiz; docs/SETUP.md §6) ---
# Geliştirmede ikisi de boş bırakılabilir: e-posta gönderilmez, doğrulama bağlantısı sunucu
# terminaline yazılır. Canlıda (NODE_ENV=production) zorunlu.
# Brevo → SMTP & API → API Keys
BREVO_API_KEY=
# Brevo'da onaylanmış gönderen adresi (Senders). Kayıt olan herkes bu adresi görür.
MAIL_FROM=
# Doğrulama bağlantısının başındaki adres. Geliştirmede arayüzün adresi, canlıda sitenin adresi.
APP_URL=http://localhost:5173
