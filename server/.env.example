# Bu dosyayı server/.env olarak kopyala ve değerleri doldur.
# Her değerin nereden alınacağı: docs/SETUP.md

# --- Sunucu ---
NODE_ENV=development
PORT=5000

# --- Veritabanı (Neon) — docs/SETUP.md#4-neon-postgresql ---
# Pooled bağlantı (adreste "-pooler" geçer). Uygulama bunu kullanır.
DATABASE_URL=
# Direct bağlantı. Şema güncellemeleri (migration) bunu kullanır.
DIRECT_URL=

# --- Kimlik doğrulama ---
# Rastgele uzun bir değer: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Dış API'ler ---
# TMDB "API Read Access Token" (eyJ ile başlar) — docs/SETUP.md#1-tmdb
TMDB_API_TOKEN=
# docs/SETUP.md#2-omdb
OMDB_API_KEY=
# docs/SETUP.md#3-google-books
GOOGLE_BOOKS_API_KEY=
# Anahtar gerekmez; Open Library kim olduğumuzu bilmek ister (uygulama adı + iletişim e-postası)
OPEN_LIBRARY_USER_AGENT="SosyalKutuphane/0.1 (email@ornek.com)"
